{
  "color": {
    "sumi": { "value": "#0B0B0C", "use": "page background" },
    "ink": { "value": "#131315", "use": "surface" },
    "ink-2": { "value": "#1B1B1E", "use": "raised surface, cards" },
    "line": { "value": "#2A2A2E", "use": "borders, HUD rules" },
    "paper": { "value": "#EDE8DC", "use": "body text, primary" },
    "ash": { "value": "#8C887E", "use": "secondary text, labels" },
    "vermilion": { "value": "#E5322D", "use": "accent: reticle, bounding boxes, CTAs, large text only" },
    "vermilion-dim": { "value": "#8E1F1C", "use": "accent fills, glows" },
    "gold": { "value": "#B89B5E", "use": "rare highlight: confidence values, active slot" }
  },
  "font": {
    "display": { "family": "Barlow Condensed", "weights": [600, 700], "case": "uppercase", "tracking": "0.02em" },
    "body": { "family": "Barlow", "weights": [400, 500, 600] },
    "hud": { "family": "JetBrains Mono", "weights": [400, 500], "use": "stats, labels, coordinates, timestamps" },
    "hosting": "self-hosted woff2, no CDN"
  },
  "type-scale-desktop": {
    "hero": "clamp(72px, 9vw, 144px) / 0.9",
    "h1": "72 / 0.95",
    "h2": "48 / 1.0",
    "h3": "28 / 1.1",
    "body": "18 / 1.55",
    "small": "14 / 1.5",
    "hud": "12 / 1.4 uppercase, tracking 0.08em"
  },
  "type-scale-mobile": {
    "hero": "56 / 0.92",
    "h1": "44 / 0.95",
    "h2": "32 / 1.0",
    "h3": "22 / 1.15",
    "body": "16 / 1.55",
    "small": "13 / 1.5",
    "hud": "11 / 1.4 uppercase, tracking 0.08em"
  },
  "space": { "unit": 4, "scale": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128, 192] },
  "grid": {
    "desktop": { "frame": 1440, "columns": 12, "gutter": 24, "margin": 64 },
    "tablet": { "frame": 768, "columns": 8, "gutter": 20, "margin": 40 },
    "mobile": { "frame": 390, "columns": 4, "gutter": 16, "margin": 20 }
  },
  "shape": {
    "radius": 0,
    "chamfer": "8px cut on top-left and bottom-right of cards and buttons (clip-path)",
    "stroke": { "hairline": 1, "hud": 1.5, "emphasis": 2 }
  },
  "motion": {
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "duration": { "micro": 120, "ui": 240, "reveal": 600, "scene": 1200 },
    "smooth-scroll": { "lib": "Lenis", "lerp": 0.08 },
    "reduced-motion": "all scene motion off, reveals become opacity fades under 200ms"
  },
  "3d": {
    "tunnel": { "ring-count": 36, "ring-spacing": 6, "radius": 3.2, "fog": "sumi, near 8, far 70" },
    "tiers": {
      "full": { "pixel-ratio-cap": 2, "postprocessing": ["bloom", "chromatic-aberration", "grain"], "particles": 4000 },
      "lite": { "pixel-ratio-cap": 1.25, "postprocessing": [], "particles": 800 },
      "static": { "webgl": false, "fallback": "poster image or short looped video" }
    },
    "budget": { "initial-3d-payload": "3 MB target", "desktop-fps": 60, "mobile-fps": 30 }
  },
  "a11y": {
    "contrast-note": "paper and ash pass AA on sumi for body text. vermilion passes for large text and UI only; never use it for small body copy.",
    "focus-ring": "2px gold, 2px offset",
    "touch-target": "44px minimum"
  }
}
