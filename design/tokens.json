{
  "color": {
    "night": {
      "value": "#0A0B09",
      "use": "page background"
    },
    "smoke": {
      "value": "#121410",
      "use": "surface"
    },
    "olive-dk": {
      "value": "#1B1F16",
      "use": "raised surface, cards"
    },
    "olive": {
      "value": "#2F3628",
      "use": "borders, HUD rules, panels"
    },
    "olive-lt": {
      "value": "#3E4833",
      "use": "hover fills, active panels"
    },
    "steel": {
      "value": "#A7ADB0",
      "use": "secondary text, labels, dog tag metal"
    },
    "bone": {
      "value": "#E7E4D8",
      "use": "body text, primary"
    },
    "ember": {
      "value": "#F0561D",
      "use": "accent: crosshair dot, CTAs, fire light, large text only"
    },
    "ember-dim": {
      "value": "#8A2F10",
      "use": "accent fills, glows"
    },
    "hazard": {
      "value": "#E7B73C",
      "use": "HUD highlights: objective labels, active slot, focus ring"
    }
  },
  "font": {
    "display": {
      "family": "Barlow Condensed",
      "weights": [
        600,
        700
      ],
      "case": "uppercase",
      "tracking": "0.02em"
    },
    "body": {
      "family": "Barlow",
      "weights": [
        400,
        500,
        600
      ]
    },
    "hud": {
      "family": "JetBrains Mono",
      "weights": [
        400,
        500
      ],
      "use": "stats, labels, coordinates, timestamps"
    },
    "hosting": "self-hosted woff2, no CDN"
  },
  "type-scale-desktop": {
    "hero": "clamp(72px, 9vw, 144px) / 0.9",
    "h1": "72 / 0.95",
    "h2": "48 / 1.0",
    "h3": "28 / 1.1",
    "body": "18 / 1.55",
    "small": "14 / 1.5",
    "hud": "12 / 1.4 uppercase, tracking 0.08em"
  },
  "type-scale-mobile": {
    "hero": "56 / 0.92",
    "h1": "44 / 0.95",
    "h2": "32 / 1.0",
    "h3": "22 / 1.15",
    "body": "16 / 1.55",
    "small": "13 / 1.5",
    "hud": "11 / 1.4 uppercase, tracking 0.08em"
  },
  "space": {
    "unit": 4,
    "scale": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64,
      96,
      128,
      192
    ]
  },
  "grid": {
    "desktop": {
      "frame": 1440,
      "columns": 12,
      "gutter": 24,
      "margin": 64
    },
    "tablet": {
      "frame": 768,
      "columns": 8,
      "gutter": 20,
      "margin": 40
    },
    "mobile": {
      "frame": 390,
      "columns": 4,
      "gutter": 16,
      "margin": 20
    }
  },
  "shape": {
    "radius": 0,
    "chamfer": "8px cut on top-right and bottom-left corners of buttons and panels (clip-path), like COD UI plates",
    "stroke": {
      "hairline": 1,
      "hud": 1.5,
      "emphasis": 2
    }
  },
  "motion": {
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "duration": {
      "micro": 120,
      "ui": 240,
      "reveal": 600,
      "scene": 1200
    },
    "smooth-scroll": {
      "lib": "Lenis",
      "lerp": 0.08
    },
    "reduced-motion": "all scene motion off, reveals become opacity fades under 200ms"
  },
  "3d": {
    "tunnel": {
      "ring-count": 36,
      "ring-spacing": 6,
      "radius": 3.2,
      "fog": "night, near 8, far 70"
    },
    "tiers": {
      "full": {
        "pixel-ratio-cap": 2,
        "postprocessing": [
          "bloom",
          "chromatic-aberration",
          "grain"
        ],
        "particles": 4000
      },
      "lite": {
        "pixel-ratio-cap": 1.25,
        "postprocessing": [],
        "particles": 800
      },
      "static": {
        "webgl": false,
        "fallback": "poster image or short looped video"
      }
    },
    "budget": {
      "initial-3d-payload": "3 MB target",
      "desktop-fps": 60,
      "mobile-fps": 30
    },
    "hero": {
      "scene": "R3F warzone: 4 parallax skyline layers, fire glows, embers (700), tracers, procedural operator run cycle, extruded steel dog tag with canvas-engraved name + bumpMap, RoomEnvironment envMap",
      "spike": "spikes/warzone-hero/index.html"
    }
  },
  "a11y": {
    "contrast-note": "bone and steel pass AA on night for body text. ember passes for large text and UI only; never use it for small body copy.",
    "focus-ring": "2px hazard, 2px offset",
    "touch-target": "44px minimum"
  },
  "theme": "Warzone: night battlefield hero, running operator silhouette, steel dog tag title, crosshair cursor. Original art only, no COD characters or logos.",
  "cursor": {
    "type": "DOM SVG crosshair",
    "behaviour": "gaps spread with mouse speed, hit-marker X on click, ember dot, native cursor hidden on pointer:fine only",
    "touch": "no custom cursor"
  }
}